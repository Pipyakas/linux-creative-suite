# Copy to config/apps.local.env (git-ignored) and fill in your installation.
# Codenames are used everywhere in this repo instead of product names.
#
# Each APP_<codename> value is   '<windows path to the exe>|<exe file name>'
# The exe file name is what KWin reports as the window's resource class (matched
# case-insensitively). Leave an entry empty to skip that app.
PREFIX="$HOME/.local/share/wineprefixes/suite"
SUITE_DIR='C:\Program Files\<vendor>'
INSTALLER_DIR='/path/to/installer/media'
APP_raster=''
APP_vector=''
APP_layout=''
APP_copyedit=''
APP_pdf=''
APP_nle=''
APP_nle_lite=''
APP_compositor=''
APP_compositor_cli=''
APP_audio=''
APP_encoder=''
APP_puppet=''
APP_photo_catalog=''
APP_asset_browser=''
APP_web_editor=''
APP_scene3d=''
APP_mat_designer=''
APP_tex_painter=''
APP_mat_sampler=''
APP_stager=''
